# Copy to .env in this directory (backend root). Values are loaded from
# this file regardless of the process working directory.

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
QDRANT_TIMEOUT=10.0

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=384

# Chunking (word windows)
CHUNK_SIZE=400
CHUNK_OVERLAP=50
MIN_CHUNK_WORDS=20

# Uploads
MAX_UPLOAD_BYTES=10485760

# BM25 JSON persistence (relative paths resolve against this project root)
BM25_INDEX_PATH=data/bm25_index.json

# Qdrant upsert batch size
UPSERT_BATCH_SIZE=64

# Hybrid RRF and rerank
DENSE_CANDIDATE_COUNT=
BM25_CANDIDATE_COUNT=
RERANK_CANDIDATE_COUNT=
RRF_K=
DENSE_WEIGHT=
BM25_WEIGHT=
RERANKER_MODEL=
RERANKER_DEVICE=
RERANKER_BATCH_SIZE=
