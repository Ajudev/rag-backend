# Copy to .env in this directory (backend root). Values are loaded from
# this file regardless of the process working directory.

# Qdrant
QDRANT_URL=
QDRANT_COLLECTION=
QDRANT_TIMEOUT=

# Embeddings
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=
EMBEDDING_DIM=

# Chunking (word windows)
CHUNK_SIZE=
CHUNK_OVERLAP=
MIN_CHUNK_WORDS=

# Uploads
MAX_UPLOAD_BYTES=

# BM25 JSON persistence (relative paths resolve against this project root)
BM25_INDEX_PATH=

# Qdrant upsert batch size
UPSERT_BATCH_SIZE=

# Hybrid RRF and rerank
DENSE_CANDIDATE_COUNT=
BM25_CANDIDATE_COUNT=
RERANK_CANDIDATE_COUNT=
RRF_K=
DENSE_WEIGHT=
BM25_WEIGHT=
RERANKER_MODEL=
RERANKER_DEVICE=
RERANKER_BATCH_SIZE=

# Grounded answers (OpenAI). API key is optional at boot; POST /answer is 503 without it.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=
OPENAI_MAX_RETRIES=
ANSWER_TOP_K=
ANSWER_CONTEXT_MAX_CHARS=
ANSWER_LOG_PROMPTS=
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=

# Citation verification (LLM judgements are fallible; not a proof of truth)
CITATION_VERIFY_ENABLED=
CITATION_VERIFY_MODEL=
VERIFY_PROMPT_VERSION=
